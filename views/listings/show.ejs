<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h2 class="mb-3"><%=listing.title%></h2>

        <div class="card listing-card shadow-sm">
             <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="Listing Image"
                >

            <div class="card-body">

                <h5 class="card-title">
                    <%= listing.title %>
                </h5>

                <p class="card-text">
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong>
                </p>

                <p class="card-text">
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <%= listing.country %>
                </p>

            </div>
        </div>

        <div class="mt-3 mb-5 d-flex gap-3">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-danger"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-dark">
                    Delete
                </button>
            </form>

        </div>

    </div>
    <hr>
    <div class="col-8 offset-3">
        <h4>Review</h4>
        <form>
            <div class="mb-3 mt-3">
                <lable for="rating" class="form-lable">Rating</lable>
                <input type="range" min="1" max="5" id="rating" name="review[rating]">
            </div>
            <div mb-3 mt-3">
                <lable for="comment" class="form-lable">Comments</lable>
                <textarea name="reviewComment" id="comment" cols="30" rows="5"></textarea>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>
</div>