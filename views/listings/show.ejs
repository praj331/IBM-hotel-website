<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <!-- Listing Details Column -->
  <div class="col-12 col-md-8 offset-md-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="fw-bold mb-0 text-break"><%= listing.title %></h2>
      <button 
        type="button" 
        class="wishlist-btn wishlist-btn-show position-static" 
        data-id="<%= listing._id %>" 
        aria-label="Save to wishlist"
        title="Save to wishlist"
      >
        <i class="fa-regular fa-heart"></i>
      </button>
    </div>

    <!-- Category & Location Header -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 text-muted small">
      <% if (listing.category) { %>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
          <i class="fa-solid fa-tag me-1"></i><%= listing.category %>
        </span>
      <% } %>
      <span><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></span>
    </div>

    <!-- Listing Card -->
    <div class="card listing-show-card shadow-sm border-0 mb-4">
      <div class="show-img-container">
        <img
          src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800' %>"
          class="card-img-top show-img rounded-4"
          alt="<%= listing.title %>"
          onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800';"
        >
      </div>

      <div class="card-body px-1 py-3">
        <p class="card-text text-secondary mb-2">
          Hosted by <strong class="text-body"><%= listing.owner ? listing.owner.username : "WanderLust Host" %></strong>
        </p>

        <p class="card-text fs-5 text-break mb-3">
          <%= listing.description %>
        </p>

        <div class="p-3 bg-body-tertiary rounded-3 mb-3 d-flex align-items-baseline gap-2">
          <span class="fs-4 fw-bold">&#8377; <%= (listing.price ?? 0).toLocaleString("en-IN") %></span>
          <span class="text-muted">/ night</span>
        </div>
      </div>
    </div>

    <!-- Owner Edit & Delete Buttons (ONLY for listing owner) -->
    <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
      <div class="d-flex gap-2 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger px-4">
          <i class="fa-solid fa-pen-to-square me-1"></i>Edit
        </a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
          <button class="btn btn-dark px-4">
            <i class="fa-solid fa-trash me-1"></i>Delete
          </button>
        </form>
      </div>
    <% } %>

    <hr class="my-4">

    <!-- Leave a Review Section -->
    <div class="mb-5">
      <h4 class="fw-bold mb-3">Reviews</h4>

      <% if (currentUser) { %>
        <div class="card p-3 shadow-sm border-0 bg-body-tertiary mb-4">
          <h5 class="fw-semibold mb-3">Leave a Review</h5>
          <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <!-- Star Rating -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Rating</label>
              <div class="star-rating d-flex gap-2 align-items-center">
                <% for (let i = 1; i <= 5; i++) { %>
                  <div class="form-check form-check-inline m-0">
                    <input class="form-check-input visually-hidden" type="radio" name="review[rating]" id="rating-<%= i %>" value="<%= i %>" <%= i === 5 ? 'checked' : '' %>>
                    <label class="form-check-label star-label" for="rating-<%= i %>" title="<%= i %> stars">
                      <i class="fa-solid fa-star fs-4"></i>
                    </label>
                  </div>
                <% } %>
                <span class="ms-2 text-muted small rating-text" id="ratingDisplay">5 / 5 stars</span>
              </div>
            </div>

            <!-- Comment -->
            <div class="mb-3">
              <label for="comment" class="form-label fw-semibold">Comments</label>
              <textarea
                name="review[comment]"
                id="comment"
                class="form-control"
                required
                rows="3"
                placeholder="Share details of your own experience at this place..."
              ></textarea>
              <div class="invalid-feedback">Please add some comments for your review.</div>
            </div>

            <button type="submit" class="btn btn-outline-dark">
              Submit Review
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="alert alert-light border shadow-sm p-3 mb-4">
          <i class="fa-solid fa-circle-info me-2 text-primary"></i>
          Want to leave a review? <a href="/login" class="fw-semibold text-danger">Log in</a> to share your experience.
        </div>
      <% } %>

      <!-- All Reviews List -->
      <% if (listing.reviews && listing.reviews.length > 0) { %>
        <h5 class="fw-semibold mb-3">All Reviews (<%= listing.reviews.length %>)</h5>
        <div class="row g-3">
          <% for(let review of listing.reviews) { %>
            <div class="col-12 col-md-6">
              <div class="card h-100 p-3 shadow-sm border">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <h6 class="fw-bold mb-0">
                      <i class="fa-regular fa-circle-user text-secondary me-1"></i>
                      <%= review.author ? review.author.username : "Guest Traveler" %>
                    </h6>
                    <small class="text-muted">
                      <%= new Date(review.createdAt).toLocaleDateString("en-IN", { year: 'numeric', month: 'short', day: 'numeric' }) %>
                    </small>
                  </div>
                  <div class="text-warning">
                    <% for (let s = 1; s <= 5; s++) { %>
                      <i class="<%= s <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star small"></i>
                    <% } %>
                  </div>
                </div>

                <p class="card-text text-break mb-3 flex-grow-1">
                  <%= review.comment %>
                </p>

                <!-- Review Delete (Only for review author) -->
                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <form
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    onsubmit="return confirm('Delete this review?');"
                    class="mt-auto"
                  >
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="fa-solid fa-trash me-1"></i>Delete Review
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-muted fst-italic">No reviews yet. Be the first to leave one!</p>
      <% } %>
    </div>

    <hr class="my-4">

    <!-- Interactive Map Section -->
    <div class="mb-5">
      <h4 class="fw-bold mb-2">Where you'll be</h4>
      <p class="text-muted small mb-3">
        <i class="fa-solid fa-location-dot text-danger me-1"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <div 
        id="map" 
        class="map-box shadow-sm rounded-4"
        data-lat="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[1] : 28.6139 %>" 
        data-lng="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[0] : 77.2090 %>" 
        data-title="<%= listing.title %>" 
        data-location="<%= listing.location %>, <%= listing.country %>"
      ></div>
    </div>
  </div>
</div>
