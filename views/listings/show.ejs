<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h2 class="mb-3">Listing Details</h2>

        <div class="card listing-card shadow-sm">
             <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="Listing Image"
                >

            <div class="card-body">

                <h5 class="card-title">
                    <%= listing.title %>
                </h5>

                <p class="card-text">
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong>
                </p>

                <p class="card-text">
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <%= listing.country %>
                </p>

            </div>
        </div>

        <div class="mt-3 mb-5 d-flex gap-3">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-danger"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-dark">
                    Delete
                </button>
            </form>

        </div>

    </div>
</div>