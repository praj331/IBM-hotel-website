<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card p-4 shadow-sm border-0 bg-body">
      <h2 class="fw-bold mb-4">Create a New Listing</h2>

      <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            class="form-control"
            placeholder="e.g. Cozy Beachfront Cottage"
            required
          >
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a catchy title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            class="form-control"
            rows="3"
            placeholder="Describe the atmosphere, amenities, and unique charms of your place..."
            required
          ></textarea>
          <div class="invalid-feedback">Please provide a description.</div>
        </div>

        <!-- Category Dropdown -->
        <div class="mb-3">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select id="category" name="listing[category]" class="form-select">
            <option value="Trending" selected>Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Domes">Domes</option>
            <option value="Boats">Boats</option>
          </select>
        </div>

        <!-- Image Upload (File or URL) -->
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-6">
            <label for="imageFile" class="form-label fw-semibold">Upload Image</label>
            <input
              type="file"
              id="imageFile"
              name="listing[image]"
              class="form-control"
              accept="image/*"
            >
            <div class="form-text small">Upload an image file from your device.</div>
          </div>
          <div class="col-12 col-md-6">
            <label for="imageUrl" class="form-label fw-semibold">Or Image URL</label>
            <input
              type="text"
              id="imageUrl"
              name="listing[imageUrl]"
              class="form-control"
              placeholder="https://example.com/photo.jpg"
            >
            <div class="form-text small">Or paste a direct image URL.</div>
          </div>
        </div>

        <!-- Price & Country -->
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-4">
            <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
            <input
              type="number"
              id="price"
              name="listing[price]"
              class="form-control"
              placeholder="1200"
              min="0"
              required
            >
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="col-12 col-md-8">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              class="form-control"
              placeholder="e.g. India"
              required
            >
            <div class="invalid-feedback">Please enter the country.</div>
          </div>
        </div>

        <!-- Location -->
        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">Location (City / State)</label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            class="form-control"
            placeholder="e.g. Jaipur, Rajasthan"
            required
          >
          <div class="invalid-feedback">Please enter the location.</div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-danger px-4">
            Create Listing
          </button>
          <a href="/listings" class="btn btn-outline-secondary">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
