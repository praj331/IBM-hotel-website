<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card p-4 shadow-sm border-0 bg-body">
      <h2 class="fw-bold mb-4">Edit Your Listing</h2>

      <!-- Update Form -->
      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=PUT"
        enctype="multipart/form-data"
        class="needs-validation"
        novalidate
      >
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input
            type="text"
            id="title"
            class="form-control"
            name="listing[title]"
            value="<%= listing.title %>"
            required
          >
          <div class="invalid-feedback">Please enter a valid title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea
            id="description"
            class="form-control"
            name="listing[description]"
            rows="3"
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <!-- Category Dropdown -->
        <div class="mb-3">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select id="category" name="listing[category]" class="form-select">
            <% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
            <% for (let cat of categories) { %>
              <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
            <% } %>
          </select>
        </div>

        <!-- Current Image Preview -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Current Image</label>
          <div>
            <img
              src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800' %>"
              class="img-fluid rounded-3 shadow-sm"
              style="max-width: 320px; height: 180px; object-fit: cover;"
              alt="<%= listing.title %>"
            >
          </div>
        </div>

        <!-- New Image Upload or URL -->
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-6">
            <label for="imageFile" class="form-label fw-semibold">Upload New Image</label>
            <input
              type="file"
              id="imageFile"
              name="listing[image]"
              class="form-control"
              accept="image/*"
            >
            <div class="form-text small">Select a file to replace current image.</div>
          </div>
          <div class="col-12 col-md-6">
            <label for="imageUrl" class="form-label fw-semibold">Or New Image URL</label>
            <input
              type="text"
              id="imageUrl"
              name="listing[imageUrl]"
              class="form-control"
              placeholder="Leave empty to keep current"
            >
            <div class="form-text small">Or paste a new image URL.</div>
          </div>
        </div>

        <!-- Price & Country -->
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-4">
            <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
            <input
              type="number"
              id="price"
              class="form-control"
              name="listing[price]"
              value="<%= listing.price %>"
              min="0"
              required
            >
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="col-12 col-md-8">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input
              type="text"
              id="country"
              class="form-control"
              name="listing[country]"
              value="<%= listing.country %>"
              required
            >
            <div class="invalid-feedback">Please enter the country.</div>
          </div>
        </div>

        <!-- Location -->
        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input
            type="text"
            id="location"
            class="form-control"
            name="listing[location]"
            value="<%= listing.location %>"
            required
          >
          <div class="invalid-feedback">Please enter the location.</div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-danger px-4">
            Update Listing
          </button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
