<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-8 offset-md-2 text-center">
    <div class="alert alert-danger shadow-sm p-4 rounded-4" role="alert">
      <i class="fa-solid fa-triangle-exclamation display-4 mb-3 text-danger"></i>
      <h3 class="alert-heading fw-bold">Oops! <%= err.statusCode || 500 %></h3>
      <p class="fs-5 mb-4"><%= err.message || "Something went wrong!" %></p>
      <hr>
      <div class="d-flex justify-content-center gap-2">
        <a href="/listings" class="btn btn-outline-danger">Back to Home</a>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
      </div>
    </div>
  </div>
</div>
